# AI Watch Web: settings of this deployment. The installer creates .env from this file and never
# overwrites an existing one. No secret belongs here: the monitor token is in secrets/monitor_key.
# (This template is called env.example, without the dot, so it shows in a folder listing.)

# The image. :latest follows the newest stable release; :vX.Y.Z is one immutable version.
AI_WATCH_WEB_IMAGE=ghcr.io/athegreat90/ai-watch-web:latest

# Where the page is served. 127.0.0.1 is this machine only.
WEB_HOST_BIND=127.0.0.1
WEB_HOST_PORT=8080

# Where the AI Watch server is, seen from inside the container: http://host or http://host:port.
# With --with-server the installer sets it up for you and this line is ignored.
UPSTREAM_URL=http://ai-watch-server:8765

# Optional default update interval of the page in milliseconds (1000 to 60000). Empty means 3000.
POLL_INTERVAL_MS=

# Only with --with-server: the server image and where it listens on this machine.
AI_WATCH_SERVER_IMAGE=ghcr.io/athegreat90/ai-watch-server:latest
MONITOR_HOST_BIND=127.0.0.1
MONITOR_HOST_PORT=8765
