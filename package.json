{
  "name": "ai-watch-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --coverage",
    "docker:build": "docker build -f docker/Dockerfile -t ai-watch-web:local .",
    "test:entrypoint": "bash docker/test/entrypoint.test.sh",
    "test:proxy": "node --test --test-timeout=120000 \"tests/proxy/*.test.mjs\"",
    "test:contract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/contract/*.test.mjs\"",
    "test:security": "python -m unittest discover -s security -p \"test_*.py\" && bash security/test_upsert_issue.sh",
    "test:release": "python -m unittest discover -s release -p \"test_*.py\"",
    "test:release:registry": "bash release/test_push_image.sh",
    "test:deploy": "bash deploy/test_install.sh",
    "test:deploy:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/test_install.ps1",
    "bench:load": "node benchmarks/load.mjs",
    "bench:page": "node benchmarks/page.mjs",
    "bench:soak": "node benchmarks/soak.mjs",
    "security:repo": "bash security/scan-repo.sh",
    "security:image": "bash security/check-image.sh",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "bootstrap": "5.3.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "angular-eslint": "22.8.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "^5.0.0"
  }
}
